APP_LOG_LEVEL=INFO
APP_LOG_FORMATTER="ColoredFormatter"
APP_LOG_DATE_FORMAT="%d-%m-%Y %H:%M:%S"
APP_LOG_FULL_COLOR=true
APP_LOG_INCLUDE_FUNCTION=true

# Groq API Key for Whisper transcription
# Get your API key from: https://console.groq.com/keys
# Download arizePhoenix Image from Docker Hub
GROQ_API_KEY=.......